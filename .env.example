# JMod runtime
JMOD_ENV=development
JMOD_DB_HOST=127.0.0.1
JMOD_DB_PORT=3306
JMOD_DB_NAME=jmod
JMOD_DB_USER=jmod
JMOD_DB_PASSWORD=change-me

# AzerothCore read access
ACORE_DB_HOST=127.0.0.1
ACORE_DB_PORT=3306
ACORE_AUTH_DB=acore_auth
ACORE_CHAR_DB=acore_characters
ACORE_WORLD_DB=acore_world
ACORE_DB_USER=readonly-user
ACORE_DB_PASSWORD=change-me

# Helper
JMOD_HELPER_SOCKET=/opt/jmod-wow/run/helper.sock
JMOD_WORLDSERVER_CONTAINER=ac-worldserver

# Web
JMOD_WEB_BIND=0.0.0.0
JMOD_WEB_PORT=8090
